{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Simple Calendar",
  "version": "0.1.0",
  "identifier": "com.krnomad.simplecalendar",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Simple Calendar",
        "width": 960,
        "height": 680,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src https://date.nager.at; style-src 'self'; script-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Small multilingual desktop calendar.",
    "longDescription": "A small desktop calendar with public holiday updates for Korea, the United States, Japan, and China."
  }
}
